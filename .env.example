# ── Primary LLM configuration (Part 2/6) ─────────────────────────────────
# Provider name (default: openai-compatible — any /v1/chat/completions API)
#LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-5.3
# Request timeout in ms (default 120000)
#LLM_TIMEOUT=120000

# ── Multi-key failover (Part 7 — AUTHORIZED keys only) ───────────────────
# Additional keys for the SAME provider, for reliability/failover of keys
# you are authorized to use. NOT a rate-limit evasion mechanism: 429
# responses are never rotated around.
#LLM_KEYS=

# ── Routing tiers (Part 8 heuristic) ─────────────────────────────────────
#FAST_MODEL=nemotron-3.5-lightning
#SMART_MODEL=glm-5.3
#COMPLEX_MODEL=glm-5.3
#PLANNING_MODEL=glm-5.3

# ── Legacy names (still supported) ───────────────────────────────────────
# GLM_API_KEY=  GLM_BASE_URL=  GLM_MODEL=
# Structured alternative: my-agent/providers.json (see README)
